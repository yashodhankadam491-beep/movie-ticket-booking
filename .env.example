# Copy to .env for local deployment. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Use a long random value in production (32+ characters).
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Required in production. Example: https://tickets.example.com
PUBLIC_ORIGIN=http://localhost:3000

# Set TRUST_PROXY=true only when HTTPS is terminated by a trusted reverse proxy.
TRUST_PROXY=false

# Optional direct HTTPS configuration. Leave empty when using a reverse proxy.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Rate limiting defaults
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5
BOOKING_RATE_LIMIT_MAX=20

# Razorpay - create TEST keys first. Never commit these values.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_test_secret

# Gateway pricing conversion used by this project when charging INR.
# The server calculates the amount; the browser cannot override it.
PAYMENT_USD_TO_INR=83.5

# Comma-separated email addresses allowed to open /admin.html and use admin APIs.
ADMIN_EMAILS=your-admin-email@example.com
