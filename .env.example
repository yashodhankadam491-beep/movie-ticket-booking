# Copy to .env for local deployment. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Use a long random value in production (32+ characters).
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Required in production. Example: https://tickets.example.com
PUBLIC_ORIGIN=http://localhost:3000

# Set TRUST_PROXY=true only when HTTPS is terminated by a trusted reverse proxy.
TRUST_PROXY=false

# Optional direct HTTPS configuration. Leave empty when using a reverse proxy.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Rate limiting defaults
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5
BOOKING_RATE_LIMIT_MAX=20
